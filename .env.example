# Database
DB_NAME=pulsecheck
DB_USER=pulsecheck
DB_PASSWORD=change_me_secure_password
# Use DB_HOST=db when running with docker-compose; localhost for local dev
DB_HOST=db
DB_PORT=5432

# JWT - generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production_use_256_bit_secret_key_here
JWT_EXPIRATION_MS=86400000

# Email (use SMTP or services like Resend, Mailgun, SendGrid)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@pulsecheck.io

# App
APP_BASE_URL=https://yourdomain.com
SPRING_PROFILES_ACTIVE=prod
